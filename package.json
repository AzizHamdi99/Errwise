{
  "name": "errwise",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "yarn workspace @errwise/web dev",
    "dev:api": "yarn workspace @errwise/api start:dev",
    "dev:worker": "yarn workspace @errwise/api start:worker:dev",
    "start:worker": "yarn workspace @errwise/api start:worker:prod",
    "build": "turbo run build",
    "build:web": "yarn workspace @errwise/web build",
    "build:api": "yarn workspace @errwise/api build",
    "dev:demo": "yarn workspace @errwise/demo-app start",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "yarn workspace @errwise/api prisma migrate dev",
    "db:studio": "yarn workspace @errwise/api prisma studio",
    "db:generate": "yarn workspace @errwise/api prisma generate",
    "db:status": "yarn workspace @errwise/api prisma migrate status",
    "db:reset": "yarn workspace @errwise/api prisma migrate reset",
    "db:status:prod": "yarn workspace @errwise/api db:status:prod",
    "db:migrate:prod": "yarn workspace @errwise/api db:migrate:prod"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
