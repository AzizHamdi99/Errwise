generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String                @id @default(uuid(7)) @db.Uuid
  email             String                @unique
  name              String?
  passwordHash      String?
  invitationsSent   Invitation[]          @relation("InvitationInviter")
  refreshTokens     RefreshToken[]
  emailVerifiedAt   DateTime?             @db.Timestamptz(3)
  googleId          String?               @unique
  lastLoginAt       DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  memberships       Membership[]
  subscriptions     ProjectSubscription[]
  emailVerification EmailVerification?
}

/// The pending email verification of a user. userId is the primary key, so there is at most one
/// link at a time and a new link replaces the old one. Only the sha256 of the token is stored,
/// like invitations and refresh tokens. The row is deleted when the link is used.
model EmailVerification {
  userId    String   @id @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  /// When the email was last sent: the resend cooldown is measured from it.
  sentAt    DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String       @unique
  invitations Invitation[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?    @db.Timestamptz(3)
  members     Membership[]
  projects    Project[]
  aiUsage     AiUsage[]
}

model Membership {
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

model Project {
  id                   String                @id @default(uuid(7)) @db.Uuid
  organizationId       String                @db.Uuid
  name                 String
  slug                 String
  platform             String                @default("node")
  retentionDays        Int                   @default(30)
  /// Opt-in. Show and analyze the code around stack frames, read from the connected repo.
  sourceContextEnabled Boolean               @default(false)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?             @db.Timestamptz(3)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  githubInstallationId String?
  githubRepo           String?
  apiKeys              ApiKey[]
  issues               Issue[]
  events               Event[]
  subscriptions        ProjectSubscription[]
  issueEnvironments    IssueEnvironment[]

  @@unique([organizationId, slug])
  @@index([githubRepo])
}

model GithubWebhookDelivery {
  id         String   @id
  event      String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([receivedAt])
}

model Invitation {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           String       @default("member")
  tokenHash      String       @unique
  invitedById    String?      @db.Uuid
  expiresAt      DateTime     @db.Timestamptz(3)
  acceptedAt     DateTime?    @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  projectId  String    @db.Uuid
  name       String
  kind       String    @default("ingest")
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Issue {
  id                       String             @id @default(uuid(7)) @db.Uuid
  projectId                String             @db.Uuid
  fingerprint              String
  fingerprintVersion       Int                @default(1)
  title                    String
  type                     String?
  level                    String             @default("error")
  status                   String             @default("unresolved")
  eventCount               Int                @default(0)
  firstSeenAt              DateTime           @db.Timestamptz(3)
  lastSeenAt               DateTime           @db.Timestamptz(3)
  firstRelease             String?
  lastRelease              String?
  resolvedAt               DateTime?          @db.Timestamptz(3)
  githubIssueNumber        Int?
  githubIssueUrl           String?
  githubIssueClaimedAt     DateTime?          @db.Timestamptz(3)
  lastNotifiedAt           DateTime?          @db.Timestamptz(3)
  githubState              String?
  regressionCount          Int                @default(0)
  lastRegressionAt         DateTime?          @db.Timestamptz(3)
  lastRegressionNotifiedAt DateTime?          @db.Timestamptz(3)
  project                  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events                   Event[]
  analyses                 IssueAnalysis[]
  environments             IssueEnvironment[]

  @@unique([projectId, githubIssueNumber])
  @@unique([projectId, fingerprint])
  // Ends with id: the list cursor is (lastSeenAt, id), so the index matches the ORDER BY.
  @@index([projectId, status, lastSeenAt(sort: Desc), id(sort: Desc)])
  // The other two sorts of the list ("first seen", "most events"), same shape as the one above.
  @@index([projectId, status, firstSeenAt(sort: Desc), id(sort: Desc)])
  @@index([projectId, status, eventCount(sort: Desc), id(sort: Desc)])
  // The "All" status tab has no status filter, so it cannot use the index above: it would scan
  // and sort the whole table. Same order, without the status.
  @@index([projectId, lastSeenAt(sort: Desc), id(sort: Desc)])
  // Trigram index for the title search (ILIKE '%term%'), needs the pg_trgm extension.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Issue_title_trgm_idx")
}

model Event {
  id          String   @id @default(uuid(7)) @db.Uuid
  eventId     String   @db.Uuid
  projectId   String   @db.Uuid
  issueId     String   @db.Uuid
  level       String   @default("error")
  type        String?
  message     String
  stack       String?
  platform    String   @default("node")
  environment String   @default("production")
  release     String?
  commitSha   String?
  sdk         String?
  context     Json?
  timestamp   DateTime @db.Timestamptz(3)
  receivedAt  DateTime @default(now()) @db.Timestamptz(3)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([projectId, eventId])
  @@index([issueId, timestamp(sort: Desc)])
  @@index([projectId, timestamp(sort: Desc)])
}

/// The environments an issue was seen in: one row per (issue, environment), written in the
/// ingestion transaction. It is a summary of Event, so the list never has to read the events
/// of an issue (a hot issue has millions) just to show "production, staging".
/// firstSeenAt is the timestamp of the event that created the row. The backfill used the oldest
/// event timestamp, and an older event that arrives later does not lower it, so treat it as
/// approximate. Nothing reads it yet.
model IssueEnvironment {
  issueId     String   @db.Uuid
  projectId   String   @db.Uuid
  environment String
  firstSeenAt DateTime @db.Timestamptz(3)
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// One row per environment of an issue; also the lookup for "issues seen in environment X".
  @@id([issueId, environment])
  /// Environments of a project (the list filter's choices).
  @@index([projectId, environment])
}

model ProjectSubscription {
  userId         String   @db.Uuid
  projectId      String   @db.Uuid
  emailNewIssues Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

/// One AI analysis per issue and input. The key is a hash of the scrubbed input, so the same
/// error never costs a second AI call, and a changed stack gets a fresh analysis.
model IssueAnalysis {
  id            String   @id @default(uuid(7)) @db.Uuid
  issueId       String   @db.Uuid
  inputHash     String
  promptVersion String
  model         String
  result        Json
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, inputHash])
}

/// AI calls made by an organization on one UTC day. The daily cap is enforced with an
/// atomic `updateMany ... where requests < cap`, so parallel requests cannot exceed it.
model AiUsage {
  organizationId String       @db.Uuid
  day            DateTime     @db.Date
  requests       Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, day])
}
