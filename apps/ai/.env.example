# Shared with the Errwise API (AI_SERVICE_SECRET). At least 16 characters.
AI_SERVICE_SECRET=change-me-to-a-long-random-string

# Any OpenAI-compatible provider. Groq by default.
LLM_API_KEY=your-provider-key
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Optional
# LLM_FIX_MODEL=openai/gpt-oss-120b   # model for code fixes, defaults to LLM_MODEL
# LLM_FIX_MAX_OUTPUT_TOKENS=2500
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_OUTPUT_TOKENS=1500
