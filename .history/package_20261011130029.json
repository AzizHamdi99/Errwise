{
  "name": "errwise",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "yarn workspace @errwise/web dev",
    "dev:api": "yarn workspace api start:dev",
    "build": "turbo run build",
    "build:web": "yarn workspace @errwise/web build",
    "build:api": "yarn workspace @errwise/api build",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
