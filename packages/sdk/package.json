{
  "name": "@errwise/node",
  "version": "0.1.1",
  "description": "Errwise SDK for Node.js: capture errors and send them to your dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzizHamdi99/errwise.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs.d.mts",
        "default": "./dist/nestjs.mjs"
      },
      "require": {
        "types": "./dist/nestjs.d.ts",
        "default": "./dist/nestjs.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "nestjs": [
        "./dist/nestjs.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "@nestjs/common": ">=9",
    "@nestjs/core": ">=9"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn typecheck && yarn test && yarn build"
  },
  "devDependencies": {
    "@errwise/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/testing": "^11",
    "@types/express": "^5",
    "@types/node": "^20",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "express": "^5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
